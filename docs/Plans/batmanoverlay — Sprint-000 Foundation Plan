# 6. Build System

## 6.1 PyInstaller Specification / Script (`scripts/build.py`)

```python
"""Build script for packaging batmanoverlay into a portable Windows executable."""

import shutil
import subprocess
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).parent.parent
DIST_DIR = ROOT_DIR / "dist"
BUILD_DIR = ROOT_DIR / "build"
SRC_DIR = ROOT_DIR / "src"
RESOURCES_DIR = ROOT_DIR / "resources"


def clean() -> None:
    """Clean existing build artifacts."""
    print("Cleaning build directories...")
    if DIST_DIR.exists():
        shutil.rmtree(DIST_DIR)
    if BUILD_DIR.exists():
        shutil.rmtree(BUILD_DIR)


def run_pyinstaller() -> None:
    """Invoke PyInstaller build."""
    print("Executing PyInstaller build...")
    cmd = [
        sys.executable,
        "-m",
        "PyInstaller",
        "--noconfirm",
        "--onedir",
        "--windowed",
        "--name=batmanoverlay",
        f"--icon={RESOURCES_DIR / 'icons' / 'app.ico'}",
        f"--add-data={RESOURCES_DIR};resources",
        "--paths=src",
        str(SRC_DIR / "main.py"),
    ]
    result = subprocess.run(cmd, cwd=ROOT_DIR, check=False)
    if result.returncode != 0:
        print("Build failed!")
        sys.exit(1)


def assemble_portable_package() -> None:
    """Assemble final portable directory layout."""
    print("Assembling portable package...")
    target_dir = DIST_DIR / "batmanoverlay"

    # Create empty data template structure
    data_dir = target_dir / "data"
    (data_dir / "config").mkdir(parents=True, exist_ok=True)
    (data_dir / "workspaces" / "default").mkdir(parents=True, exist_ok=True)
    (data_dir / "sessions").mkdir(parents=True, exist_ok=True)
    (data_dir / "logs").mkdir(parents=True, exist_ok=True)

    # Copy LICENSE and README
    shutil.copy(ROOT_DIR / "LICENSE", target_dir)
    shutil.copy(ROOT_DIR / "README.md", target_dir)

    print(f"Portable build complete: {target_dir}")


def main() -> None:
    clean()
    run_pyinstaller()
    assemble_portable_package()


if __name__ == "__main__":
    main()
```

