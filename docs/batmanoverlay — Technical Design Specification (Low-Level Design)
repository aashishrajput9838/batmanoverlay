    """Central signal hub. One instance per application."""

    # ── Clipboard signals ──
    clipboard_entry_added = Signal(object)           # payload: ClipboardEntry
    clipboard_entry_deleted = Signal(str)             # payload: entry_id
    clipboard_entry_updated = Signal(object)          # payload: ClipboardEntry
